-- The metalogic used in side conditions.

grammar
  v ::= n | true | false | skip
  e ::= v | e + e
  n ::= int

show 1 + 2 * 3
show 7 / 2
show -(4 - 6)
show 1 < 2 < 3
show 1 < 3 < 2
show 2 in {1, 2, 3}
show 5 in int

-- no runtime errors: ill-defined things are arb, and arb equals nothing
show 7 / 0
show 1 + true
show (1 / 0) = (1 / 0)
show (1 / 0) < 1 || (1 / 0) >= 1
show arb in int
show if 1 / 0 then 1 else 2

-- where: lazy, bindings in any order, a self-reference is arb
show total where total = inner + border and inner = 3 * 4 and border = 2 * (3 + 4)
show 1 where unused = 1 / 0
show x where x = x + 1

-- object terms and grammar categories
show `1 + 2` in e
show `1 + true` in e
show `skip` in v
show `1 + 2` = `1 + 2`
show `1 + 2` = `2 + 1`

-- stores and sets
show dom {`x` |-> 1, `y` |-> 2}
show {`x` |-> 1}(`x`)
show {`x` |-> 1}(`y`)
show {`x` |-> 1}[`x` |-> 5][`z` |-> 0]
show {3, 1, 2, 1}
