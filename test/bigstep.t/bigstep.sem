-- L1 in big-step style: (e, s) ==> (v, s') says e evaluates to the value v,
-- turning store s into s'. The same grammar as the small-step L1; only the
-- relation and its rules differ.

grammar
  op ::= + | >=
  v  ::= n | true | false | skip
  e  ::= v | l | e op e | !l | l := e | e ; e
       | if e then e else e | while e do e
  l  ::= name
  n  ::= int
  s  ::= store

fixity  infixr 1 ;   infix 2 :=   infix 3 >=   infixl 4 +   prefix 5 !

relation (e, s) ==> (v, s)  shown "#1 \Downarrow #2"

rule val     (v, s) ==> (v, s)
rule op+     (e1 + e2, s) ==> (n, s'')
               if (e1, s) ==> (n1, s'), (e2, s') ==> (n2, s''), n = n1 + n2
rule op>=    (e1 >= e2, s) ==> (v, s'')
               if (e1, s) ==> (n1, s'), (e2, s') ==> (n2, s''), v = (n1 >= n2)
rule deref   (!l, s) ==> (n, s)  if l in dom s, n = s(l)
rule assign  (l := e, s) ==> (skip, s'')
               if (e, s) ==> (n, s'), l in dom s', s'' = s'[l |-> n]
rule seq     (e1 ; e2, s) ==> (v, s'')  if (e1, s) ==> (skip, s'), (e2, s') ==> (v, s'')
rule if1     (if e1 then e2 else e3, s) ==> (v, s'')  if (e1, s) ==> (true, s'), (e2, s') ==> (v, s'')
rule if2     (if e1 then e2 else e3, s) ==> (v, s'')  if (e1, s) ==> (false, s'), (e3, s') ==> (v, s'')
rule while1  (while e1 do e2, s) ==> (skip, s''')
               if (e1, s) ==> (true, s'), (e2, s') ==> (skip, s''), (while e1 do e2, s'') ==> (skip, s''')
rule while2  (while e1 do e2, s) ==> (skip, s')  if (e1, s) ==> (false, s')

query (x := !x + 1 ; !x, {x |-> 41}) ==> ?
query (x := 0 ; while 2 >= !x do x := !x + 1, {x |-> 99}) ==> ?

-- a loop that repeats a state has no derivation: the search notices the
-- goal recurring rather than running forever
query (while true do skip, {}) ==> ?
-- a type error is stuck, so it has no derivation either
query (1 + true, {}) ==> ?
