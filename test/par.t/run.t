  $ semplay par.sem
  step (x := 1 || x := 2, {x |-> 0})
    par1: (skip || x := 2, {x |-> 1})
    par2: (x := 1 || skip, {x |-> 2})
  run (x := 1 || x := 2, {x |-> 0})
    (skip, {x |-> 1})
    (skip, {x |-> 2})
  run (x := !x + 1 || x := !x + 1, {x |-> 0})
    (skip, {x |-> 1})
    (skip, {x |-> 2})
  run (x := 1 || x := 2 || x := 3, {x |-> 0})
    (skip, {x |-> 1})
    (skip, {x |-> 2})
    (skip, {x |-> 3})
